.PHONY: install format lint test openapi

# docs/jotform-openapi.yaml is generated by `make openapi`, so it is left as written; manifests/ and
# reports/ hold local, gitignored files.
YAMLFIX = poetry run yamlfix . --exclude 'docs/jotform-openapi.yaml' --exclude '.venv/**/*' --exclude 'manifests/**/*' --exclude 'reports/**/*'

install:
	poetry install

format:
	poetry run ruff format .
	poetry run ruff check --fix .
	$(YAMLFIX)

lint:
	poetry run ruff format --check .
	poetry run ruff check .
	$(YAMLFIX) --check

test:
	poetry run pytest

